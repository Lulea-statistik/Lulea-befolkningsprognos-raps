  "demography": {
    "fertility": {"localLevelWindow": 9, "nationalFuturePath": true},
    "mortality": {"localLevelWindow": 10, "nationalFuturePath": true},
    "domesticInMigration": {
      "riskWindow": 6,
      "riskPopulation": "rest_of_sweden",
      "ageSexDistributionWindow": 9,
      "splitWithinAndOutsideCounty": true
    },
    "domesticOutMigration": {
      "riskWindow": 6,
      "ageSexDistributionWindow": 9,
      "splitWithinAndOutsideCounty": true
    },
    "internationalInMigration": {
      "municipalityShareOfNationalWindow": 5,
      "ageSexDistributionWindow": 9,
      "nationalFutureImmigration": true
    },
    "internationalOutMigration": {
      "riskWindow": 9
    }
  },
  "dimensions": {
    "age": "single_year",
    "sex": true,
    "birthStatus": {
      "requiredForFullProfetLikeImplementation": true,
      "categories": ["sweden_born", "foreign_born"],
      "currentModelStatus": "not_yet_active_in_population_state"
    }
  },
  "consistencyAdjustment": {
    "requiredForFullProfetLikeImplementation": true,
    "municipalitiesToCounty": true,
    "countiesToNational": true,

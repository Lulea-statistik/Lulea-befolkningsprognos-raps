      "calibrationWindowYears": 10,
      "transitionBasis": "national cohort changes by sex and one-year age",
      "transitionDirection": "adjacent_upward_only",
      "estimation": "For each lower state j, estimate p(j->j+1) from positive year-to-year increase in the national cohort share at or above state j+1 divided by the prior cohort share in state j; event-weighted over the locked 10-year window and clamped to [0,1].",
      "simulation": "Apply all adjacent promotions simultaneously to the prior cohort distribution, then age the cohort one year.",
